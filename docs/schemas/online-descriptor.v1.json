{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hinagata:online-descriptor:v1",
  "title": "Online scoring descriptor",
  "description": "What a deployer needs to run a model version as an online scoring service (docs/descriptors.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "namespace",
    "model",
    "version",
    "artifact_digest",
    "version_manifest",
    "runtime",
    "signature",
    "monitoring",
    "resources",
    "health"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "version_manifest": {
      "$ref": "#/$defs/version_manifest"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "monitoring": {
      "$ref": "#/$defs/monitoring"
    },
    "format": {
      "const": "hinagata.online-descriptor/v1"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_mib",
        "replicas"
      ],
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256000
        },
        "memory_mib": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveness_path",
        "readiness_path"
      ],
      "properties": {
        "liveness_path": {
          "const": "/healthz"
        },
        "readiness_path": {
          "const": "/readyz"
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "nullable"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -1
          }
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tensor"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tensor"
          }
        }
      }
    },
    "version_manifest": {
      "description": "The version's GetVersionManifest response (docs/signatures.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "key_id",
        "manifest",
        "signature",
        "metadata"
      ],
      "properties": {
        "format": {
          "const": "hinagata.signature/v1"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "metadata": {
          "type": "string"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "image"
      ],
      "properties": {
        "engine": {
          "const": "onnx"
        },
        "image": {
          "type": "string",
          "description": "Empty for the deployer's default ONNX runtime image."
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/v1/"
        },
        "format": {
          "type": "string"
        }
      }
    },
    "monitoring": {
      "description": "Registry paths that take this version's prediction summaries and labeled aggregates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_summaries",
        "labeled_aggregates"
      ],
      "properties": {
        "prediction_summaries": {
          "$ref": "#/$defs/endpoint"
        },
        "labeled_aggregates": {
          "$ref": "#/$defs/endpoint"
        }
      }
    }
  }
}
